PORT=8080
NODE_ENV=production
SESSION_TTL_HOURS=8
# Altere para true somente quando o Nginx estiver publicado com HTTPS.
COOKIE_SECURE=false

# Banco padrão: SQLite em data/guias.db (não exige nenhuma configuração).
# Para usar MySQL/MariaDB, remova o "#" das linhas abaixo e preencha os dados.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=sisglosa
# DB_USER=sisglosa
# DB_PASSWORD=troque_esta_senha
