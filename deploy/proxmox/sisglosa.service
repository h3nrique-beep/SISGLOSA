[Unit]
Description=SISGLOSA
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sisglosa
Group=sisglosa
WorkingDirectory=/opt/sisglosa
EnvironmentFile=/etc/sisglosa/sisglosa.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server.js
# always: o painel encerra o processo após um pacote que muda o servidor, e o systemd o sobe de novo.
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
# A aplicação grava em data/ (banco e cópias das atualizações) e substitui
# server.js, lib/ e public/ quando o administrador envia um pacote .zip.
ReadWritePaths=/opt/sisglosa

[Install]
WantedBy=multi-user.target
